<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.2</version>
    <relativePath/>
  </parent>

  <groupId>org.diegoreyes</groupId>
  <artifactId>web-scraper</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>Web Scraper</name>
  <description>
    Product web scraper microservice developed with Java 21,
    Spring Boot 3, Clean Architecture, Spring Data JPA, PostgreSQL,
    OpenAPI / Swagger-UI, JUnit 5 and Mockito.
  </description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>

    <project.build.sourceEncoding>
      UTF-8
    </project.build.sourceEncoding>

    <project.reporting.outputEncoding>
      UTF-8
    </project.reporting.outputEncoding>

    <jsoup.version>1.18.3</jsoup.version>
    <springdoc.version>2.8.4</springdoc.version>
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencies>

    <!-- Spring Boot Web Starter for REST API -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Boot Data JPA for ORM & Repository Pattern -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Spring Boot Validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- PostgreSQL Driver -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Springdoc OpenAPI Starter with Swagger UI -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- HTML download and parsing -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>${jsoup.version}</version>
    </dependency>

    <!-- H2 in-memory Database for isolated tests and dev fallback -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Spring Boot Test Starter (JUnit 5, Mockito, AssertJ, Spring MVC Test) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Compile production code and tests with Java 21 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.httpserver</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Execute JUnit 5 tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>
            @{argLine} -Dnet.bytebuddy.experimental=true -XX:+EnableDynamicAgentLoading --add-modules jdk.httpserver
          </argLine>
        </configuration>
      </plugin>

      <!-- Spring Boot Maven Plugin -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.diegoreyes.webscraper.WebScraperApplication</mainClass>
        </configuration>
      </plugin>

      <!-- Generate and verify code coverage -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>

        <executions>

          <!-- Attach JaCoCo agent before tests -->
          <execution>
            <id>prepare-agent</id>

            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>

          <!-- Generate HTML report -->
          <execution>
            <id>generate-report</id>
            <phase>verify</phase>

            <goals>
              <goal>report</goal>
            </goals>
          </execution>

          <!-- Require 100% coverage in the domain core -->
          <execution>
            <id>check-domain-coverage</id>
            <phase>verify</phase>

            <goals>
              <goal>check</goal>
            </goals>

            <configuration>
              <rules>

                <rule>
                  <element>CLASS</element>

                  <includes>
                    <include>
                      org.diegoreyes.webscraper.domain.*
                    </include>
                    <include>
                      org.diegoreyes.webscraper.domain.model.*
                    </include>
                    <include>
                      org.diegoreyes.webscraper.domain.valueobject.*
                    </include>
                    <include>
                      org.diegoreyes.webscraper.domain.exception.*
                    </include>
                    <include>
                      org.diegoreyes.webscraper.domain.repository.*
                    </include>
                    <include>
                      org.diegoreyes.webscraper.domain.port.*
                    </include>
                  </includes>

                  <limits>

                    <!-- 100% line coverage -->
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>

                    <!-- 100% branch coverage -->
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>

                  </limits>
                </rule>

              </rules>
            </configuration>
          </execution>

        </executions>
      </plugin>

    </plugins>
  </build>

</project>